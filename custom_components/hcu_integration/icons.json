{
    "entity": {
        "light": {
            "hcu_light": {
                "state_attributes": {
                    "effect": {
                        "state": {
                            "off": "mdi:lightbulb-off",
                            "on": "mdi:lightbulb",
                            "blinking_middle": "mdi:alarm-light",
                            "flash_middle": "mdi:flash",
                            "billow_middle": "mdi:waves"
                        }
                    }
                }
            }
        },
        "climate": {
            "hcu_climate": {
                "state_attributes": {
                    "preset_mode": {
                        "default": "mdi:thermostat",
                        "state": {
                            "boost": "mdi:rocket-launch",
                            "eco": "mdi:leaf",
                            "party": "mdi:party-popper"
                        }
                    }
                }
            }
        },
        "binary_sensor": {
            "hcu_window": {
                "default": "mdi:window-closed-variant",
                "state": {
                    "on": "mdi:window-open-variant",
                    "off": "mdi:window-closed-variant"
                }
            },
            "hcu_door": {
                "default": "mdi:door-closed",
                "state": {
                    "on": "mdi:door-open",
                    "off": "mdi:door-closed"
                }
            },
            "hcu_intrusion_alarm": {
                "default": "mdi:shield-check",
                "state": {
                    "on": "mdi:shield-alert"
                }
            },
            "hcu_safety_alarm": {
                "default": "mdi:home-alert-outline",
                "state": {
                    "on": "mdi:home-alert"
                }
            }
        },
        "button": {
            "hcu_device_identify": {
                "default": "mdi:crosshairs-question"
            },
            "hcu_pull_latch": {
                "default": "mdi:door-open"
            },
            "hcu_acknowledge_safety_alarm": {
                "default": "mdi:bell-check-outline"
            }
        },
        "sensor": {
            "hcu_tiltwindow": {
                "default": "mdi:window-closed-variant",
                "state": {
                    "closed": "mdi:window-closed-variant",
                    "open": "mdi:window-open-variant",
                    "tilted": "mdi:angle-acute"
                }
            }
        }
    },
    "services": {
        "play_sound": "mdi:music-note",
        "set_rule_state": "mdi:playlist-edit",
        "activate_party_mode": "mdi:party-popper",
        "activate_vacation_mode": "mdi:airplane",
        "activate_eco_mode": "mdi:leaf",
        "deactivate_absence_mode": "mdi:home-account",
        "switch_on_with_time": "mdi:timer-outline",
        "set_cooling_mode": "mdi:snowflake",
        "send_api_command": "mdi:api",
        "create_user_message_request": "mdi:message-badge",
        "delete_user_message_request": "mdi:message-off"
    }
}
